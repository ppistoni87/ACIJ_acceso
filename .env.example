# Copiar a .env y ajustar. No commitear .env.
BN_ENTORNO=local

# Rol migrador (aplica DDL). En producción, un rol distinto por responsabilidad.
# En la base gestionada las tres URL apuntan al mismo proyecto de Neon con
# usuarios distintos; ver docs/operacion/neon.md. Los valores reales van al
# gestor de secretos o a .env.local, que git ignora: nunca a un archivo versionado.
BN_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/backend_normativo
# Rol lector_api: solo lectura sobre proyecciones publicadas.
BN_DATABASE_URL_API=postgresql+psycopg://bn_lector_api:CAMBIAR@127.0.0.1:5432/backend_normativo
# Rol ingestor: escribe capturas y candidatos.
BN_DATABASE_URL_INGESTA=postgresql+psycopg://bn_ingestor:CAMBIAR@127.0.0.1:5432/backend_normativo

BN_OBJETOS_BASE_URI=file://var/objetos
BN_SQL_ECHO=false

# Proveedor de modelo para la generación de respuestas (P-013). Sin clave, el
# sistema contesta en modo extracto: texto publicado, literal y citado. No se
# finge generación.
BN_MODELO_CLAVE=
BN_MODELO_URL=https://api.anthropic.com/v1/messages
BN_MODELO_NOMBRE=claude-sonnet-5
BN_MODELO_TIMEOUT=30

# Límites de uso en servidor (P-017, criterio 3). El balde vive en memoria del
# proceso: con varias instancias el límite efectivo se multiplica por la
# cantidad de instancias. En 0 queda desactivado, que sirve para medir el techo
# del servicio y no para servir a nadie.
BN_LIMITE_CONSULTAS_POR_MINUTO=120
BN_LIMITE_AUTENTICACIONES_FALLIDAS=10
# Cuántos proxies propios hay delante. En 0 —el valor por omisión— se ignora
# `X-Forwarded-For` entera: esa cabecera la pone quien llama, y creerle
# convierte el límite en un adorno.
BN_PROXIES_CONFIABLES=0

# Retención de la traza de consultas (P-017, criterio 2). Se aplica con
# `bn operacion purgar-consultas`. Ver docs/operacion/politica_de_datos.md.
BN_RETENCION_CONSULTAS_DIAS=90
